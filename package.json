{
    "name": "@starter-solutions/vue-ui",
    "version": "0.1.4",
    "description": "Open-source shadcn-vue components and composables.",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./base": {
            "types": "./dist/components/base/index.d.ts",
            "import": "./dist/components/base/index.js"
        },
        "./base/*": {
            "types": "./dist/components/base/*/index.d.ts",
            "import": "./dist/components/base/*/index.js"
        },
        "./custom": {
            "types": "./dist/components/custom/index.d.ts",
            "import": "./dist/components/custom/index.js"
        },
        "./custom/*": {
            "types": "./dist/components/custom/*/index.d.ts",
            "import": "./dist/components/custom/*/index.js"
        },
        "./composables": {
            "types": "./dist/composables/index.d.ts",
            "import": "./dist/composables/index.js"
        },
        "./composables/*": {
            "types": "./dist/composables/*.d.ts",
            "import": "./dist/composables/*.js"
        },
        "./styles.css": "./dist/style.css"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "prepack": "npm run build",
        "typecheck": "vue-tsc --noEmit"
    },
    "keywords": [
        "vue",
        "ui",
        "components",
        "composables",
        "shadcn"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Starter-Solutions/vue-ui.git"
    },
    "homepage": "https://github.com/Starter-Solutions/vue-ui#readme",
    "bugs": {
        "url": "https://github.com/Starter-Solutions/vue-ui/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "peerDependencies": {
        "vue": "^3.5"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.3.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.0",
        "vite": "^7.0.0 || ^8.0.0",
        "vite-plugin-dts": "^4.5.0",
        "vue": "^3.5.0",
        "vue-tsc": "^3.0.0"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.3",
        "@lucide/vue": "^1.34.0",
        "@unovis/vue": "^1.6.7",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-vue": "^8.6.0",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "vee-validate": "^4.15.1",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.9",
        "zod": "^3.25.76"
    }
}
