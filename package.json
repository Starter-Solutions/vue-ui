{
    "name": "@starter-solutions/vue-ui",
    "version": "0.1.0",
    "description": "Open-source shadcn-inspired Vue components and composables.",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./composables": {
            "types": "./dist/composables/index.d.ts",
            "import": "./dist/composables/index.js"
        },
        "./styles.css": "./dist/style.css"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "prepack": "npm run build",
        "typecheck": "vue-tsc --noEmit"
    },
    "keywords": [
        "vue",
        "ui",
        "components",
        "composables",
        "shadcn"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/starter-solutions/vue-ui.git"
    },
    "homepage": "https://github.com/starter-solutions/vue-ui#readme",
    "bugs": {
        "url": "https://github.com/starter-solutions/vue-ui/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "peerDependencies": {
        "vue": "^3.5"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.0",
        "typescript": "^5.9.0",
        "vite": "^7.0.0 || ^8.0.0",
        "vite-plugin-dts": "^4.5.0",
        "vue": "^3.5.0",
        "vue-tsc": "^3.0.0"
    }
}
